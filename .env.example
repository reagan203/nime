# Where Nine's summaries go
LEADS_TO=anup.tabe@ninthmind.ai
MAIL_FROM="Nine at Ninth Mind <nine@ninthmind.ai>"

# Option 1: Resend (https://resend.com). Set the key and verify the MAIL_FROM domain.
RESEND_API_KEY=

# Option 2: any SMTP server (Microsoft 365, Google Workspace, Mailgun, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# With neither set, development writes each email to .data/outbox/ instead of sending it.
# Leads are always appended to $DATA_DIR/leads.jsonl.
DATA_DIR=.data

# The website report: visits, sources, and where people spend their time
REPORT_TO=anup.tabe@ninthmind.ai
# weekly (Monday morning, for the week before), daily, monthly, or off
REPORT_FREQUENCY=weekly
# the hour it goes out, Nairobi time
REPORT_HOUR=8
# a secret for the browser preview: /api/report?key=...&days=7
REPORT_KEY=
